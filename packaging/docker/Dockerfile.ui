FROM debian:bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git unzip xz-utils zip ca-certificates \
    clang cmake ninja-build pkg-config \
    libgtk-3-dev libblkid-dev liblzma-dev \
&& rm -rf /var/lib/apt/lists/*

# packaging/build.sh runs this image with --user "$(id -u):$(id -g)", and
# flutter needs a writable HOME for its pub cache, so the builder account has
# to carry the invoking user's ids. Defaults suit a typical workstation; CI
# passes its own via --build-arg.
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000
RUN getent group ${BUILDER_GID} || groupadd -g ${BUILDER_GID} builder \
    && useradd -m -u ${BUILDER_UID} -g ${BUILDER_GID} builder
USER builder
WORKDIR /home/builder

ARG FLUTTER_VERSION=3.44.8
RUN curl -fsSL -o flutter.tar.xz \
      "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
    && tar xf flutter.tar.xz && rm flutter.tar.xz
ENV PATH="/home/builder/flutter/bin:${PATH}"
RUN flutter config --no-analytics --enable-linux-desktop && flutter precache --linux

WORKDIR /src
